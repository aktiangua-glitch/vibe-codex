# Copy the values you need into your shell environment. Spring Boot does not
# load this file automatically.
VELA_BRIDGE_TOKEN=replace-with-at-least-32-random-characters
VELA_BIND_ADDRESS=0.0.0.0
VELA_BRIDGE_PORT=8787

# "auto" finds Codex in the ChatGPT/Codex app bundle or PATH.
VELA_CODEX_ENABLED=true
VELA_CODEX_EXECUTABLE=auto
VELA_DEFAULT_CWD=/Users/you/path/to/project

# codex sends the WAV as localAudio. Use volcengine to transcribe first.
VELA_ASR_PROVIDER=codex
# VOLCENGINE_ASR_API_KEY=
# VOLCENGINE_ASR_RESOURCE_ID=volc.bigasr.auc_turbo

# Optional; default is ~/.vela-dial/recordings.
# VELA_RECORDINGS_DIR=/Users/you/.vela-dial/recordings
