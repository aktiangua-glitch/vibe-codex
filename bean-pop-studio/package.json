{
  "name": "bean-pop-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync:palettes": "node ./scripts/sync-public-palettes.mjs",
    "predev": "npm run sync:palettes",
    "prebuild": "npm run sync:palettes",
    "pretest": "npm run sync:palettes",
    "build:palette-compare": "node ./scripts/build-palette-compare-html.mjs",
    "build:app": "vite build",
    "build:skill": "vite build --config vite.skill.config.js",
    "dev": "npm run build:skill && vite",
    "build": "npm run build:skill && npm run build:app",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}
